# --- Flask ---
SECRET_KEY=replace-with-a-long-random-string
JWT_SECRET=replace-with-another-long-random-string
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Database ---
# local MongoDB, docker-compose, or a MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017/linksense
# auto = use MongoDB, fall back to in-memory if it is not running | true = always in-memory | false = MongoDB only
USE_MOCK_DB=auto

# --- Cache / rate limiting ---
# if Redis isn't running the app falls back to an in-memory cache automatically
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SHORTEN=30/minute

# --- URLs ---
BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- ML ---
PHISHING_WARN_THRESHOLD=0.5
PHISHING_BLOCK_THRESHOLD=0.8

# fill the in-memory database with a demo account on startup
SEED_DEMO=true
